rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isStudent() {
      return isAuthenticated() && getUserData().role == 'STUDENT';
    }

    function isOfficer() {
      return isAuthenticated() && getUserData().role == 'OFFICER';
    }

    function isAdmin() {
      return isAuthenticated() && (getUserData().role == 'ADMIN' || getUserData().role == 'SUPER_ADMIN');
    }

    function isSuperAdmin() {
      return isAuthenticated() && getUserData().role == 'SUPER_ADMIN';
    }

    // Students Collection
    match /students/{studentId} {
      // Students can only read their own profile; Officers, Admin, and Super Admin can read permitted records
      allow read: if isAuthenticated() && (
        (isStudent() && studentId == request.auth.token.email.replace('@mkce.ac.in', '')) ||
        isOfficer() ||
        isAdmin()
      );

      // Students can only edit non-protected fields of their own profile
      allow update: if isAuthenticated() && (
        (isStudent() && 
         studentId == request.auth.token.email.replace('@mkce.ac.in', '') &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['registerNumber', 'email', 'normalizedRegisterNumber', 'normalizedEmail', 'confirmationId'])) ||
        isOfficer() ||
        isAdmin()
      );

      // Only Admins and Super Admins can create or delete student records
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }

    // Users Collection (Authentication metadata)
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isSuperAdmin();
    }

    // Officers Collection
    match /officers/{officerId} {
      allow read: if isAuthenticated() && (request.auth.uid == officerId || isAdmin());
      allow write: if isSuperAdmin();
    }

    // Staff Accounts Collection (Directory of Faculty & Admins)
    match /staff_accounts/{staffId} {
      allow read: if isAuthenticated();
      allow write: if isOfficer() || isAdmin();
    }

    // Admin Collection
    match /admin/{adminId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // Requests Collection (Officer Request Center)
    match /requests/{requestId} {
      allow read: if isOfficer() || isAdmin();
      allow create: if isOfficer() || isAdmin();
      allow update: if isAdmin(); // Only Admins can approve or reject
      allow delete: if isSuperAdmin();
    }

    // Announcements Collection
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create, update: if isOfficer() || isAdmin();
      allow delete: if isAdmin();
    }

    // Audit Logs Collection (Immutable logging)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Audit logs must be tamper-proof and immutable
    }

    // System Settings Collection
    match /systemSettings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }
  }
}
