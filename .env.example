# CIVIL CONNECT - Environment Configuration Template
# Duplicate this file as '.env.local' to configure your live credentials.

# --- Firebase Configuration ---
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# --- Cloudinary Configuration ---
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=civil_connect_preset
VITE_CLOUDINARY_API_KEY=your_cloudinary_api_key

# --- College Portal Settings ---
VITE_COLLEGE_DOMAIN=mkce.ac.in
VITE_ADMIN_PIN_HASH=654321
